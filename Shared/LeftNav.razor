                                <path d="M86.1352 22.3541V29.6038C86.1352 30.0678 85.8842 30.1538 85.7777 30.1847C85.7227 30.2019 83.4814 30.6969 79.8445 30.6969C75.5184 30.6969 72.1823 28.227 72.1823 23.7944C72.1823 23.3819 72.1772 23.2306 72.1772 20.4944C72.1772 14.7417 76.627 13.4131 80.0937 13.4131C83.2184 13.4131 84.3219 13.6795 85.5009 13.8583C85.6127 13.8755 85.7141 13.9081 85.7983 13.9545C85.8619 13.9889 85.9169 14.0319 85.9633 14.08C86.0578 14.1797 86.1128 14.3103 86.1128 14.4633V15.5684C86.1128 15.6716 86.0802 15.9844 85.7055 16.0531C85.6591 16.0617 85.6058 16.0669 85.5473 16.0669C85.5473 16.0669 85.4562 16.0669 85.4305 16.0634C85.2156 16.0445 82.9297 15.7816 80.2931 15.7816C76.6391 15.7816 74.7398 17.3405 74.7398 20.6491V23.5503C74.7398 26.9672 76.9983 28.3559 79.9631 28.3559C82.2972 28.3559 83.5691 28.1308 83.5691 28.1308V23.9147H81.9878C81.6681 23.9147 81.2745 23.6809 81.2745 23.2856C81.2745 22.8903 81.2694 22.8714 81.2694 22.3558C81.2694 21.8402 81.6784 21.6374 81.9878 21.6374H85.4373C85.855 21.6374 86.1334 21.988 86.1334 22.3558" fill="currentColor"/>
                            </g>
                        }
                    </g>
                    <defs>
                        <clipPath id="clip0">
                            <rect width="222.992" height="44" fill="white"/>
                        </clipPath>
                    </defs>
                </svg>
                @if (!_isCollapsed)
                {
                    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                                   OnClick="@ToggleTheme"
                                   Class="theme-toggle-btn-mud"
                                   Size="Size.Small"
                                   aria-label="Toggle theme" />
                }
            </div>
        </div>

        <!-- Main Menu Toggle -->
        <div class="collapse-toggle-mud" @onclick="ToggleCollapse" role="button" tabindex="0">
            @if (!_isCollapsed)
            {
                <span class="menu-text-mud">Main Menu</span>
            }
            <span class="chevron-container-mud">
                <MudIcon Icon="@(_isCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)" Size="Size.Small" />
            </span>
        </div>

        <!-- Search -->
        <div class="left-nav-search-container-mud">
            <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Class="left-nav-search-icon-mud" />
            @if (!_isCollapsed)
            {
                <MudTextField T="string"
                              Placeholder="Search..."
                              Variant="Variant.Text"
                              Margin="Margin.Dense"
                              Class="left-nav-search-input-mud"
                              Underline="false" />
            }
        </div>

        <!-- Navigation Menu -->
        <nav class="nav-menu-mud">
            <!-- Facility Section -->
            <div class="nav-section-mud @(_expandedSections.Contains("facility") ? "expanded" : "")">
                <MudButton Variant="Variant.Text"
                           Class="@GetNavItemClass("facility", true)"
                           OnClick="@(() => ToggleSection("facility"))"
                           FullWidth="true"
                           title="Facility">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Class="nav-icon-mud" />
                    @if (!_isCollapsed)
                    {
                        <span class="nav-label-mud">Facility</span>
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Class="expand-icon-mud" />
                    }
                </MudButton>
                @if (_expandedSections.Contains("facility") && !_isCollapsed)
                {
                    <div class="nav-submenu-mud">
                        <MudButton Variant="Variant.Text" Href="/property" Class="@GetNavItemClass("property", false, true)" FullWidth="true" title="Property">
                            <span class="nav-label-mud">Property</span>
                        </MudButton>
                        <MudButton Variant="Variant.Text" Href="#" Class="@GetNavItemClass("installation", false, false)" FullWidth="true" title="Installation">
                            <span class="nav-label-mud">Installation</span>
                        </MudButton>
                        <MudButton Variant="Variant.Text" Href="#" Class="@GetNavItemClass("site", false, false)" FullWidth="true" title="Site">
                            <span class="nav-label-mud">Site</span>
                        </MudButton>
                        <MudButton Variant="Variant.Text" Href="#" Class="@GetNavItemClass("building", false, false)" FullWidth="true" title="Building">
                            <span class="nav-label-mud">Building</span>
                        </MudButton>
                        <MudButton Variant="Variant.Text" Href="#" Class="@GetNavItemClass("room", false, false)" FullWidth="true" title="Room">
                            <span class="nav-label-mud">Room</span>
                        </MudButton>
                        <MudButton Variant="Variant.Text" Href="#" Class="@GetNavItemClass("object", false, false)" FullWidth="true" title="Object">
                            <span class="nav-label-mud">Object</span>
                        </MudButton>
                        <MudButton Variant="Variant.Text" Href="#" Class="@GetNavItemClass("sections", false, false)" FullWidth="true" title="Sections">
                            <span class="nav-label-mud">Sections</span>
                        </MudButton>
                        <MudButton Variant="Variant.Text" Href="#" Class="@GetNavItemClass("furnishing", false, false)" FullWidth="true" title="Furnishing">
                            <span class="nav-label-mud">Furnishing</span>
                        </MudButton>
                        <MudButton Variant="Variant.Text" Href="#" Class="@GetNavItemClass("inventory", false, false)" FullWidth="true" title="Inventory">
                            <span class="nav-label-mud">Inventory</span>
                        </MudButton>
                    </div>
                }
            </div>

            <!-- Map Section -->
            <div class="nav-section-mud @(_expandedSections.Contains("map") ? "expanded" : "")">
                <MudButton Variant="Variant.Text"
                           Class="@GetNavItemClass("map", true)"
                           OnClick="@(() => ToggleSection("map"))"
                           FullWidth="true"
                           title="Map">
                    <MudIcon Icon="@Icons.Material.Filled.Map" Class="nav-icon-mud" />
                    @if (!_isCollapsed)
                    {
                        <span class="nav-label-mud">Map</span>
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Class="expand-icon-mud" />
                    }
                </MudButton>
            </div>

            <!-- Activity Section -->
            <div class="nav-section-mud @(_expandedSections.Contains("activity") ? "expanded" : "")">
                <MudButton Variant="Variant.Text"
                           Class="@GetNavItemClass("activity", true)"
                           OnClick="@(() => ToggleSection("activity"))"
                           FullWidth="true"
                           title="Activity">
                    <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Class="nav-icon-mud" />
                    @if (!_isCollapsed)
                    {
                        <span class="nav-label-mud">Activity</span>
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Class="expand-icon-mud" />
                    }
                </MudButton>
            </div>

            <!-- Agent Section -->
            <div class="nav-section-mud @(_expandedSections.Contains("agent") ? "expanded" : "")">
                <MudButton Variant="Variant.Text"
                           Class="@GetNavItemClass("agent", true)"
                           OnClick="@(() => ToggleSection("agent"))"
                           FullWidth="true"
                           title="Agent">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="nav-icon-mud" />
                    @if (!_isCollapsed)
                    {
                        <span class="nav-label-mud">Agent</span>
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Class="expand-icon-mud" />
                    }
                </MudButton>
            </div>

            <!-- Agreement Section -->
            <div class="nav-section-mud @(_expandedSections.Contains("agreement") ? "expanded" : "")">
                <MudButton Variant="Variant.Text"
                           Class="@GetNavItemClass("agreement", true)"
                           OnClick="@(() => ToggleSection("agreement"))"
                           FullWidth="true"
                           title="Agreement">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Class="nav-icon-mud" />
                    @if (!_isCollapsed)
                    {
                        <span class="nav-label-mud">Agreement</span>
                        <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Class="expand-icon-mud" />
                    }
                </MudButton>
            </div>
        </nav>
    </aside>

    <!-- Mobile Overlay -->
    @if (_isMobileOpen)
    {
        <div class="mobile-overlay-mud" @onclick="CloseMobileNav"></div>
    }
</div>

@code {
    private bool _isCollapsed = false;
    private bool _isDarkMode = false;
    private bool _isMobileOpen = false;
    private HashSet<string> _expandedSections = new() { "facility" }; // Facility expanded by default
    private string _activeItem = "property";

    private void ToggleCollapse()
    {
        _isCollapsed = !_isCollapsed;
    }

    private void ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        // In a real app, trigger actual theme switching
    }

    private void ToggleSection(string section)
    {
        if (_expandedSections.Contains(section))
            _expandedSections.Remove(section);
        else
            _expandedSections.Add(section);
    }

    private void CloseMobileNav()
    {
        _isMobileOpen = false;
    }

    private string GetNavItemClass(string item, bool isParent, bool isActive = false)
    {
        var classes = new List<string> { "nav-item-mud" };

        if (isParent)
            classes.Add("nav-parent-mud");
        else
            classes.Add("nav-child-mud");

        if (isActive || _activeItem == item)
            classes.Add("active");

        return string.Join(" ", classes);
    }
}
